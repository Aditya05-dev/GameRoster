  "description": "Real backend for the gaming companion platform: Express + PostgreSQL + JWT auth. Matches SCHEMA.md.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
