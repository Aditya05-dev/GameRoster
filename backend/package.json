{
  "name": "gaming-companion-api",
  "version": "1.0.0",
  "description": "Real backend for the gaming companion platform: Express + PostgreSQL + JWT auth. Matches SCHEMA.md.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "seed:genshin": "node src/db/seed-genshin.js",
    "sync:genshin": "node src/db/sync-genshin.js",
    "catalog:build": "node scripts/build-catalog.mjs",
    "test:isolated": "node scripts/isolated-check.mjs",
    "test:ui": "node scripts/isolated-check.mjs --ui",
    "format": "prettier --write src/**/*.js tests/**/*.js scripts/*.mjs ../frontend/src/**/*.{js,jsx,css}"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "genshin-db": "5.2.14",
    "playwright": "1.62.1",
    "prettier": "3.8.3",
    "supertest": "^7.0.0"
  }
}
