# Copy to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection (Railway/Render/Supabase all give you one of these)
DATABASE_URL=postgres://user:password@host:5432/gaming_platform
PGSSL=true

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Server
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://your-frontend-domain.com

# Initial admin account — created by `npm run seed` if no admin exists yet.
# Change the password immediately after first login; this is a bootstrap
# mechanism, not meant to be the account's permanent credential.
SEED_ADMIN_USERNAME=GameMaster
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_PASSWORD=change-this-before-deploying

# Enka.Network is built in for public Genshin showcases; no API key required.
# Catalog data is a pinned, committed snapshot. See docs/DATA_SOURCES.md.
